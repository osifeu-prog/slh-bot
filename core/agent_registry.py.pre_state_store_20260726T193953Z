import json
from pathlib import Path
from datetime import datetime

from core.audit import log_event


DB_PATH = Path("state/db.json")
SNAPSHOT_PATH = Path("state/agents.json")


def _load_db():
    with DB_PATH.open("r", encoding="utf-8") as f:
        return json.load(f)


def _save_db(db):
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)

    with DB_PATH.open("w", encoding="utf-8") as f:
        json.dump(
            db,
            f,
            indent=2,
            ensure_ascii=False
        )


def _save_snapshot(agents):
    SNAPSHOT_PATH.parent.mkdir(parents=True, exist_ok=True)

    with SNAPSHOT_PATH.open("w", encoding="utf-8") as f:
        json.dump(
            agents,
            f,
            indent=2,
            ensure_ascii=False
        )


def load_agents():
    """
    Load active agents from the canonical DB.
    """
    db = _load_db()
    return db.setdefault("agents", {})


def list_agents():
    return load_agents()


def get_agent(identifier):
    """
    Resolve by canonical ID or by display name.
    """
    agents = load_agents()

    key = str(identifier)

    if key in agents:
        return key, agents[key]

    for agent_id, agent in agents.items():
        if str(agent.get("name", "")).lower() == key.lower():
            return agent_id, agent

    return None, None


def create_agent(name, role="agent"):
    """
    Create a new agent using the next numeric ID.
    """
    name = str(name).strip()

    if not name:
        raise ValueError("Agent name cannot be empty")

    db = _load_db()
    agents = db.setdefault("agents", {})

    for agent in agents.values():
        if str(agent.get("name", "")).lower() == name.lower():
            raise ValueError(f"Agent '{name}' already exists")

    numeric_ids = []

    for key in agents:
        try:
            numeric_ids.append(int(key))
        except (TypeError, ValueError):
            pass

    next_id = str(max(numeric_ids, default=0) + 1)

    agent = {
        "name": name,
        "state": "idle",
        "role": role,
        "inbox": [],
        "history": [],
        "permissions": [],
        "created": datetime.now().isoformat(),
    }

    agents[next_id] = agent
    db["agents"] = agents

    _save_db(db)
    _save_snapshot(agents)

    log_event(
        "agent.created",
        target=next_id,
        details={
            "name": name,
            "role": role,
        },
    )

    return next_id, agent


def update_agent(identifier, **updates):
    agent_id, agent = get_agent(identifier)

    if agent is None:
        raise KeyError(f"Agent '{identifier}' not found")

    db = _load_db()
    agents = db.setdefault("agents", {})

    agents[agent_id].update(updates)
    db["agents"] = agents

    _save_db(db)
    _save_snapshot(agents)

    log_event(
        "agent.updated",
        target=agent_id,
        details={
            "updates": updates,
        },
    )

    return agent_id, agents[agent_id]


def delete_agent(identifier):
    agent_id, agent = get_agent(identifier)

    if agent is None:
        raise KeyError(f"Agent '{identifier}' not found")

    db = _load_db()
    agents = db.setdefault("agents", {})

    del agents[agent_id]
    db["agents"] = agents

    _save_db(db)
    _save_snapshot(agents)

    log_event(
        "agent.deleted",
        target=agent_id,
        details={
            "name": agent.get("name"),
        },
    )

    return agent_id, agent


def send_message(identifier, message):
    agent_id, agent = get_agent(identifier)

    if agent is None:
        raise KeyError(f"Agent '{identifier}' not found")

    db = _load_db()
    agents = db.setdefault("agents", {})

    agents[agent_id].setdefault("inbox", []).append(str(message))
    db["agents"] = agents

    _save_db(db)
    _save_snapshot(agents)

    log_event(
        "agent.message_sent",
        target=agent_id,
        details={
            "message_length": len(str(message)),
        },
    )

    return agent_id


def get_inbox(identifier):
    agent_id, agent = get_agent(identifier)

    if agent is None:
        raise KeyError(f"Agent '{identifier}' not found")

    return list(agent.get("inbox", []))


def sync_snapshot():
    agents = load_agents()
    _save_snapshot(agents)
    return len(agents)
