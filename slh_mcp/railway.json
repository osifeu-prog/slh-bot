{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "slh_mcp/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"exec python -m uvicorn slh_mcp.server:app --host 0.0.0.0 --port ${PORT:-8080}\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}